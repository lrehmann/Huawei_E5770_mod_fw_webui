#!/system/bin/busybox sh
# The old HTTP download-and-execute bootstrap is intentionally unavailable.
set -eu
case "${1:-status}" in
    status)
        if [ -x /opt/bin/busybox ]; then echo 'Entware is installed'; else echo 'Entware is not installed'; fi
        if [ -f /data/userdata/entware_autorun ]; then echo 'Autorun is enabled'; else echo 'Autorun is disabled'; fi
        ;;
    install)
        echo 'Network bootstrap is disabled: the upstream installer executes unauthenticated HTTP downloads.' >&2
        echo 'Use a reviewed, pinned offline package bundle after the dependency rebuild.' >&2
        exit 1
        ;;
    enable)
        [ -x /opt/etc/init.d/rc.unslung ] || { echo 'Entware is not installed' >&2; exit 1; }
        touch /data/userdata/entware_autorun
        ;;
    disable) rm -f /data/userdata/entware_autorun;;
    shell) [ -x /opt/bin/sh ] && exec /opt/bin/sh -l; exit 1;;
    remove)
        echo 'Automatic recursive removal is disabled. Back up /opt, stop its services, and remove a verified mount manually.' >&2
        exit 1
        ;;
    *) echo 'Usage: entware status|install|enable|disable|shell|remove' >&2; exit 2;;
esac
